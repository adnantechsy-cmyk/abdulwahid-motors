# Server-side (SSR, generateMetadata, sitemap). Local Docker: http://nginx/api/v1
API_URL_INTERNAL=http://localhost:8080/api/v1
# Browser
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must equal REVALIDATE_SECRET in the Laravel .env
REVALIDATE_SECRET=change-me

# Google sign-in: the OAuth Web client ID (same value as GOOGLE_CLIENT_ID in the Laravel .env). Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# How a checkout ends. 'request' (default): the sales team contacts the customer and takes payment, then records it in the admin.
# 'online': the customer is sent to the payment page. Baked in at build time.
NEXT_PUBLIC_CHECKOUT_MODE=request
