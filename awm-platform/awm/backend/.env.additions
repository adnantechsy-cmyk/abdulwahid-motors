# ---- Abdul Wahid Motors: add these to backend/.env ----
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Damascus

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=awm
DB_USERNAME=awm
DB_PASSWORD=secret

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REVALIDATE_SECRET=change-me            # must equal REVALIDATE_SECRET in frontend/.env.local
AWM_DEFAULT_CURRENCY=USD

# First admin. Local falls back to admin@awm.test / password.
# Production: set both, run the seeder once, then delete these two lines.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Only read on the FIRST seed of the stripe gateway row (then stored encrypted in the DB).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
