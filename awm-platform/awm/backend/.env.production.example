APP_NAME="Abdul Wahid Motors"
APP_ENV=production
APP_KEY=                                  # php artisan key:generate (once, then never change: payment keys are encrypted with it)
APP_DEBUG=false
APP_URL=https://api.abdulwahidmotors.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Damascus

LOG_CHANNEL=daily
LOG_LEVEL=warning

# hPanel -> Databases -> MySQL Databases. Hostinger shared hosting uses localhost.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_awm
DB_USERNAME=u000000000_awm
DB_PASSWORD=

# No Redis on shared hosting: database-backed cache (supports locks), sessions and queue.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# hPanel -> Emails. Create noreply@abdulwahidmotors.com first.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@abdulwahidmotors.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@abdulwahidmotors.com
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://abdulwahidmotors.com
CORS_ALLOWED_ORIGINS=https://abdulwahidmotors.com,https://www.abdulwahidmotors.com
REVALIDATE_SECRET=                        # long random string; same value in the Node.js app env
AWM_DEFAULT_CURRENCY=USD

# First deploy only, then delete these two lines.
ADMIN_EMAIL=
ADMIN_PASSWORD=
